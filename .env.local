# ─── SEO: Site URL ──────────────────────────────────────────
# Used in: sitemap.xml, canonical URLs, OpenGraph tags, schema.org JSON-LD
# Local dev → http://localhost:3000
# Production → your Render URL (already set in .env)
NEXT_PUBLIC_SITE_URL=https://tiny-nest.onrender.com

# ─── Google Search Console Verification ─────────────────────
# Get this from: https://search.google.com/search-console
# → Add Property → HTML Tag → copy the content="..." value
# Leave empty until your site is live on a real domain
GOOGLE_SITE_VERIFICATION=

